# ====== আবশ্যক ======
DATABASE_URL=postgres://USER:STRONG_PASSWORD@HOST:5432/DBNAME
# কমপক্ষে ৩২ অক্ষর, র‍্যান্ডম। তৈরি করুন:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# ====== ইমেইল (Resend) ======
RESEND_API_KEY=
RESEND_FROM="Your Brand <orders@your-domain.com>"

# ====== Google লগইন ======
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ====== কুরিয়ার (Steadfast) ======
STEADFAST_API_KEY=
STEADFAST_SECRET_KEY=
# কমপক্ষে ১৬ অক্ষর। Steadfast-এ ওয়েবহুকে হেডার দিন:  x-webhook-secret: <এই মান>
STEADFAST_WEBHOOK_SECRET=

# ====== রেট লিমিট (Vercel/serverless-এ প্রায় বাধ্যতামূলক) — Upstash Redis REST ======
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ====== ছবির অনুমোদিত রিমোট হোস্ট (কমা দিয়ে) ======
IMAGE_HOSTS=
